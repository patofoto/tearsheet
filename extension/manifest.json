{
  "manifest_version": 3,
  "name": "Tearsheet",
  "version": "1.14",
  "description": "Save photos from the web to Tearsheet: right-click a photo (Instagram and Pinterest at full size), collect a whole Tumblr tag, YouPic portfolio or page, and start a library scan",
  "key": "",
  "permissions": [
    "contextMenus",
    "storage",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tearsheet: collect photos, scan the library"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "48": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "option-rightclick.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.tumblr.com/*",
        "https://*.tumblr.com/*",
        "https://www.instagram.com/*",
        "https://instagram.com/*",
        "https://*.pinterest.com/*",
        "https://pinterest.com/*"
      ],
      "js": [
        "page-context.js"
      ],
      "run_at": "document_start"
    }
  ],
  "options_page": "options.html"
}
